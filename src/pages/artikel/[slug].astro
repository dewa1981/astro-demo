---
// Halaman artikel dinamis — [slug].astro
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/posts';
export async function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}
const { post } = Astro.props;
---
<Layout title={`${post.title} — Chokdi Astro`} description={post.excerpt}>
  <a class="back" href="/artikel">← Semua Artikel</a>
  <article>
    <span class="badge">{post.emoji}</span>
    <h1>{post.title}</h1>
    <time>{post.date}</time>
    <div class="content">
      <p>{post.excerpt}</p>
      <hr />
      <div set:html={post.content} />
    </div>
  </article>
</Layout>

<style>
  article h1 { margin-top: 8px; }
  article time { display: block; margin-bottom: 16px; }
  .content hr { border: none; border-top: 1px solid var(--border); margin: 16px 0; }
  .content h2 { margin-top: 20px; }
  .content table { width: 100%; border-collapse: collapse; margin: 12px 0; }
  .content th, .content td { border: 1px solid var(--border); padding: 8px 12px; text-align: left; }
  .content th { background: rgba(88,166,255,0.1); color: var(--accent); }
  .content code { background: rgba(88,166,255,0.12); padding: 2px 6px; border-radius: 4px; font-size: 0.9em; }
</style>
